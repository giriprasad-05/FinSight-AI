# ===================================================================
# FinSight AI — ML Microservice Environment Configuration
# ===================================================================

# ── Local LLM Polishing Layer ──────────────────────────────────────
# Set to 'true' to enable local LLM natural language polishing layer.
# When 'false', deterministic explanation engine is used without LLM.
LLM_ENABLED=false

# OpenAI-compatible API base URL (e.g. LM Studio, Ollama, vLLM, LocalAI)
LLM_BASE_URL=http://localhost:1234/v1

# API Key (LM Studio default is 'lm-studio')
LLM_API_KEY=lm-studio

# Model name. Leave blank to auto-discover the currently loaded model from /v1/models.
LLM_MODEL=

# Request timeout in seconds for local inference
LLM_TIMEOUT_SECONDS=15

# Generation sampling temperature
LLM_TEMPERATURE=0.2

# Generation token budget (keep low for fast token-efficient responses)
LLM_MAX_TOKENS=600
