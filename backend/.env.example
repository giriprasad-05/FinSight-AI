# FinSight AI Backend — Environment Variables
# Copy this file to .env and fill in values for your environment.

# ── Server ──────────────────────────────────────────────────────────
PORT=5000

# ── Python ML Service ────────────────────────────────────────────────
# URL where the FastAPI ML service is running
ML_SERVICE_URL=http://127.0.0.1:8000

# Timeout in milliseconds for ML service calls (prediction + risk are slow)
ML_TIMEOUT_MS=30000

# ── Frontend ─────────────────────────────────────────────────────────
# Origin(s) allowed by CORS. Comma-separate multiple origins.
# Default Vite dev server port is 5173.
FRONTEND_URL=http://localhost:5173

# ── Environment ──────────────────────────────────────────────────────
NODE_ENV=development

# ── Authentication ───────────────────────────────────────────────────
# Optional: Secret used to sign HMAC tokens (defaults to built-in secret if unset)
# AUTH_SECRET=your-random-32-character-secret
# Optional: Pre-seeded credentials (defaults to demo@finsight.ai / FinSight2026!)
# AUTH_USER_EMAIL=demo@finsight.ai
# AUTH_USER_USERNAME=demo
# AUTH_USER_PASSWORD=FinSight2026!
# AUTH_USER_NAME="FinSight Investor"
